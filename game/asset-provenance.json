      "digest": "8badc0a49fe1ca3977c9ed1fc888333decb6183c73e4835c9a5330243e452879",
      "roles": [
        {
          "description": "당신이 한 명만 선택해 조작하는 강태준·윤시혁·서하린·한유진의 탑다운 2D 픽셀 캐릭터 역할입니다. 이동, 공격, 회피/대시와 각 인물의 무기 운용 상태를 구분합니다.",
          "id": "player_characters",
          "label": "출격 캐릭터 4종"
        },
        {
          "description": "일반·질주·자폭·독액투사·괴력 바위투척 적을 실루엣과 행동으로 즉시 구분하는 역할입니다. 대량 출현 상황에서도 위험도와 공격 유형이 읽혀야 합니다.",
          "id": "enemy_types",
          "label": "일반 적 5종"
        },
        {
          "description": "40·80·100단계의 주요 전투를 명확히 알리는 대형 보스 역할입니다. 일반 적과 혼동되지 않으며 최종 보스까지 단계별 위계를 보여줍니다.",
          "id": "stage_bosses",
          "label": "40·80·100단계 보스"
        },
        {
          "description": "첫 전투에 존재하는 지휘본부 군용 텐트와, 이후 당신이 7×7 구역에 배치하는 2×1 일반 건물 6종의 역할입니다. 체력, 강화, 철거 및 점유 상태를 읽을 수 있어야 합니다.",
          "id": "hq_and_buildings",
          "label": "지휘본부와 일반 건물 6종"
        },
        {
          "description": "기본·중기관총·로켓·전기·화염·냉각·수리 포탑과 1칸 지상 방벽의 역할입니다. 1×1 점유, 기능 차이, 강화 상태를 구분하되 방벽 중첩이나 벽 위 포탑처럼 보이지 않게 합니다.",
          "id": "turrets_and_walls",
          "label": "포탑 7종과 지상 방벽"
        },
        {
          "description": "플레이어 추적 카메라에 맞는 어두운 제주 도심 탑다운 전장 역할입니다. 고정 화면 타워디펜스가 아니라 이동 가능한 개방형 공간과 중앙 건설구역의 동서남북 열린 입구를 명확히 보여줍니다.",
          "id": "jeju_battlefield",
          "label": "개방형 제주 도심 전장"
        },
        {
          "description": "자폭 예고, 원거리 공격 방향 경고, 착탄 예고, 회피 시간과 자동·수동 공격의 피드백을 전달하는 역할입니다. 대량전투 중에도 캐릭터와 건설 정보를 가리지 않아야 합니다.",
          "id": "combat_telegraphs",
          "label": "공격 경고와 전투 판독 효과"
        },
        {
          "description": "당신의 수동 배치 중 충돌·비용·점유·입구·탈출경로의 유효 및 실패 상태를 즉시 구분하는 역할입니다. 전투가 계속되는 동안에도 배치 칸과 위험을 함께 읽을 수 있어야 합니다.",
          "id": "building_feedback",
          "label": "건설 배치·검사 피드백"
        }
      ]
    },
