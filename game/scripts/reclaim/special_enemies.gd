static func definition(kind: String) -> Dictionary:
	if not TYPES.has(kind):
		return {}
	var row: Array = TYPES[kind]
	return {"name": row[0], "intro": row[1], "hp": row[2], "speed": row[3], "attack": row[4],
		"scale": row[5], "color": Color(row[6]), "period": row[7], "ranged": kind == "S07"}


static func airborne(kind: String) -> bool:
	return kind in ["S13", "S14", "S15"]
